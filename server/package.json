{
  "name": "musing-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create musing",
    "db:init": "wrangler d1 execute musing --file=./schema.sql",
    "db:seed": "wrangler d1 execute musing --file=./seed.sql",
    "db:init:local": "wrangler d1 execute musing --local --file=./schema.sql",
    "db:seed:local": "wrangler d1 execute musing --local --file=./seed.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240117.0",
    "typescript": "^5.3.3",
    "wrangler": "^3.24.0"
  }
}
